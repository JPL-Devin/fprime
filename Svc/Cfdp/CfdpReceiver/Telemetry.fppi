@ The total number of complete files received via CFDP
telemetry FilesReceived: U32 id 0x00

@ The total number of PDUs received
telemetry PdusReceived: U32 id 0x01

@ The total number of warnings
telemetry Warnings: U32 id 0x02

@ Total bytes received across all transactions
telemetry TotalBytesReceived: U64 id 0x03
