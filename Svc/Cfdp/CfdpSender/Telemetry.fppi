@ The total number of files sent via CFDP
telemetry FilesSent: U32 id 0x00

@ The total number of PDUs sent
telemetry PdusSent: U32 id 0x01

@ The total number of warnings
telemetry Warnings: U32 id 0x02

@ The current CFDP transaction sequence number
telemetry TransactionSeqNum: U32 id 0x03

@ Total bytes sent across all transactions
telemetry TotalBytesSent: U64 id 0x04
