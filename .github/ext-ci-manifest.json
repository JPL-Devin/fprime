{
  "upstream_repository": "JPL-Devin/fprime",
  "check_prefix": "ext-ci",
  "paths_ignore": [
    "docs/**",
    "**.md",
    ".github/actions/spelling/**",
    ".github/ISSUE_TEMPLATE/**",
    ".github/agents/**"
  ],
  "repos": [
    {
      "id": "ext-a",
      "repository": "JPL-Devin/fprime-test-ci-ext-a",
      "workflow": "ci.yml",
      "default_ref": "main",
      "timeout_minutes": 30,
      "failure_policy": "block",
      "owners": [
        "thomas-bc"
      ],
      "on_pr": true
    },
    {
      "id": "ext-b",
      "repository": "JPL-Devin/fprime-test-ci-ext-b",
      "workflow": "ci.yml",
      "default_ref": "main",
      "timeout_minutes": 30,
      "failure_policy": "notify",
      "owners": [
        "thomas-bc"
      ],
      "on_pr": true
    }
  ],
  "_fork_testing": "Stand-in config for the JPL-Devin fork (remove together with the feature-branch push trigger in ext-ci.yml before going upstream): the real fprime-community entries cannot be dispatched until their ci.yml is on the default branch, so the ext-a/ext-b stubs are used."
}
